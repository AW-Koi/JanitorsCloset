<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- The closet's utility sink: janitors bring their cart here to change its water and wet their mop. -->
  <ThingDef ParentName="BuildingBase">
    <defName>Janitor_UtilitySink</defName>
    <label>utility sink</label>
    <description>A deep steel basin with a tap, set low enough to fill a mop bucket. Janitors wheel their cart here to tip out the dirty water and fill it again.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Janitor_UtilitySink</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1, 1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <canOverlapZones>false</canOverlapZones>
    <designationCategory>Misc</designationCategory>
    <researchPrerequisites>
      <li>Sanitation</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>15</Mass>
    </statBases>
    <costList>
      <Steel>40</Steel>
    </costList>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <constructEffect>ConstructMetal</constructEffect>
  </ThingDef>

</Defs>
