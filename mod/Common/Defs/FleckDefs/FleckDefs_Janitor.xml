<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Breathing glow under the glittervacuum head, respawned by GlittervacuumGlow. -->
  <FleckDef>
    <defName>Janitor_GlittervacuumPulse</defName>
    <fleckSystemClass>Verse.FleckSystemStatic</fleckSystemClass>
    <altitudeLayer>MoteLow</altitudeLayer>
    <graphicData>
      <texPath>Things/Mote/LightningGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <graphicClass>Graphic_Fleck</graphicClass>
      <color>(0.45, 0.85, 1.0, 1.0)</color>
    </graphicData>
    <fadeInTime>0.08</fadeInTime>
    <solidTime>0.3</solidTime>
    <fadeOutTime>0.4</fadeOutTime>
  </FleckDef>

  <!-- Spotless moment: a glint over the janitor, then faint twinkles across the room floor. -->
  <FleckDef>
    <defName>Janitor_SpotlessGlint</defName>
    <fleckSystemClass>Verse.FleckSystemStatic</fleckSystemClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <graphicData>
      <texPath>Things/Mote/Janitor_Glint</texPath>
      <shaderType>MoteGlow</shaderType>
      <graphicClass>Graphic_Fleck</graphicClass>
      <color>(1.0, 0.97, 0.88, 0.85)</color>
    </graphicData>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.3</solidTime>
    <fadeOutTime>0.55</fadeOutTime>
  </FleckDef>

  <FleckDef>
    <defName>Janitor_SpotlessShimmer</defName>
    <fleckSystemClass>Verse.FleckSystemStatic</fleckSystemClass>
    <altitudeLayer>MoteLow</altitudeLayer>
    <graphicData>
      <texPath>Things/Mote/Janitor_Glint</texPath>
      <shaderType>MoteGlow</shaderType>
      <graphicClass>Graphic_Fleck</graphicClass>
      <color>(0.85, 0.95, 1.0, 0.45)</color>
    </graphicData>
    <fadeInTime>0.2</fadeInTime>
    <solidTime>0.05</solidTime>
    <fadeOutTime>0.45</fadeOutTime>
  </FleckDef>

</Defs>
