<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Without this, PE maps Industrial techLevel to Firearm proficiency. -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Janitor_HazmatSprayer"]</xpath>
    <value>
      <li Class="ProgressionEducation.ItemProficiencyRequirement">
        <requiredProficiency>PE_LowTechProficiency</requiredProficiency>
      </li>
    </value>
  </Operation>

</Patch>
